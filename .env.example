# =============================================================================
# CONFIGURACIÓN DEL SERVIDOR BACKEND Y CORS
# =============================================================================
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000/api

# =============================================================================
# BASE DE DATOS MYSQL 8+ (SEQUELIZE ORM)
# =============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=arcatem_pos
DB_USER=root
DB_PASSWORD=tu_password_mysql

# =============================================================================
# ENTORNO FISCAL ARCA / AFIP ("homologacion" o "produccion")
# =============================================================================
ARCA_ENV=homologacion

# =============================================================================
# DATOS FISCALES DEL EMISOR (CONSTANCIA DE INSCRIPCIÓN ARCA)
# =============================================================================
# CUIT de 11 dígitos SIN guiones (ej: 20123456789)
ARCA_CUIT=20000000000
EMISOR_RAZON_SOCIAL=MI EMPRESA S.R.L.
EMISOR_NOMBRE_FANTASIA=MI COMERCIO
# Condición frente al IVA del Emisor: RESPONSABLE_INSCRIPTO | MONOTRIBUTO | EXENTO
EMISOR_CONDICION_IVA=RESPONSABLE_INSCRIPTO
EMISOR_DOMICILIO_COMERCIAL=Av. Siempre Viva 742, CABA
EMISOR_IIBB=901-000000-0
EMISOR_INICIO_ACTIVIDADES=2020-01-01

# Punto de Venta habilitado para Web Services (Número entero, ej: 1)
ARCA_PTO_VTA=1

# =============================================================================
# CERTIFICADOS Y ENDPOINTS - HOMOLOGACIÓN (TESTING - WSASS)
# =============================================================================
ARCA_HOMO_CERT_PATH=./certs/certificado_homo.pem
ARCA_HOMO_KEY_PATH=./certs/privada_homo.key
ARCA_HOMO_WSAA_URL=https://wsaahomo.afip.gov.ar/ws/services/LoginCms
ARCA_HOMO_WSFE_URL=https://wswhomo.afip.gov.ar/wsfev1/service.asmx

# =============================================================================
# CERTIFICADOS Y ENDPOINTS - PRODUCCIÓN (FACTURACIÓN REAL)
# =============================================================================
ARCA_PROD_CERT_PATH=./certs/certificado_prod.pem
ARCA_PROD_KEY_PATH=./certs/privada_prod.key
ARCA_PROD_WSAA_URL=https://wsaa.afip.gov.ar/ws/services/LoginCms
ARCA_PROD_WSFE_URL=https://servicios1.afip.gov.ar/wsfev1/service.asmx

# =============================================================================
# OPCIONES CRIPTOGRÁFICAS Y CACHÉ WSAA
# =============================================================================
OPENSSL_BIN=openssl
ARCA_TOKEN_SAFETY_MARGIN_MINUTES=5
ARCA_SOAP_TIMEOUT_MS=15000
